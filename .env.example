# OmniFM Environment Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit .env or any private keys to version control.

# =============================================================================
# Execution Mode & Distributed Federation (Mode B)
# =============================================================================
# Required non-empty shared secret token when running in Mode B (Two-Laptop Distributed Mode).
# Must match on Laptop A (Coordinator) and Laptop B (Remote Client Worker).
# Single-Laptop Mode (Mode A) works with this left empty.
FL_CLIENT_AUTH_TOKEN=your-secure-random-token-here

# Maximum seconds coordinator waits for remote clients in each communication round before marking round FAILED.
DISTRIBUTED_ROUND_TIMEOUT_SEC=300

# =============================================================================
# API & Database Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./omnifm.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# Blockchain Audit Settings (Ganache Local RPC)
# =============================================================================
GANACHE_URL=http://127.0.0.1:8545
GANACHE_CHAIN_ID=1337
CONTRACT_ADDRESS=0xbEFE9C52315C84beC3085D6B2Ac261DE4b624650
BLOCKCHAIN_AUDIT_ENABLED=false

# Development Private Keys (Ganache default deterministic accounts - NEVER use on mainnet)
SERVER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CLIENT1_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
CLIENT2_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
CLIENT3_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# =============================================================================
# OmniFM Spectral Hyperparameters
# =============================================================================
SPALIGN_LAMBDA=0.1
GSKR_TOP_K=2
EMBEDDING_DIM=128
ECA_NUM_HEADS=4
SPECTRAL_LOW_PASS_RATIO=0.25
MAX_KNOWLEDGE_BANK_SIZE=1000

# =============================================================================
# Storage & Paths
# =============================================================================
ARTIFACT_DIR=./artifacts
DATASET_DIR=./datasets
KNOWLEDGE_BANK_PATH=./backend/fl/knowledge_bank.pt

# =============================================================================
# Training Defaults & Precision Policy
# =============================================================================
NUM_CLIENTS=3
DEFAULT_NUM_ROUNDS=20
SMOKE_NUM_ROUNDS=5
DEFAULT_LOCAL_EPOCHS=1
RANDOM_SEED=42
PRECISION_POLICY=fp16_amp
